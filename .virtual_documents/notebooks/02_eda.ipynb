import re

tools_vocab = sorted(
    status_student["tools"].str.split(",").explode().str.strip().dropna().unique()
)


def extract_tools(desc, vocab):
    if pd.isna(desc):
        return []
    hasil = []
    for t in vocab:
        pattern = r"\b" + re.escape(t) + r"\b"
        if re.search(pattern, desc, re.IGNORECASE):
            hasil.append(t)
    return hasil


talent_request["extracted_tools"] = talent_request["deskripsi_requirement"].apply(
    lambda d: extract_tools(d, tools_vocab)
)
talent_request["n_extracted"] = talent_request["extracted_tools"].apply(len)

match_rate = (talent_request["n_extracted"] > 0).mean() * 100
print(
    f"Vocabulary tools: {len(tools_vocab)} tools unik (dari kolom status_student.tools)"
)
print(f"Match rate (request dengan >=1 tool terdeteksi): {match_rate:.1f}%\n")

print(
    """
CATATAN METODOLOGI PENTING: percobaan pertama pakai substring match naive
menghasilkan match rate PALSU 99,5% -- ternyata tool bernama "R" (1 huruf)
false-positive cocok ke HAMPIR SEMUA teks (menangkap huruf "r" di kata
apapun, misal "dasar", "koordinator"). Diperbaiki pakai WORD-BOUNDARY regex
(\\b...\\b) supaya hanya cocok sebagai kata utuh, bukan potongan kata lain.
Match rate sebenarnya: 38,7% (bukan 99,5%).
"""
)

print(
    f"Dari {len(talent_request):,} request, {talent_request['n_extracted'].gt(0).sum():,} punya tools yang bisa diekstrak eksplisit."
)
print(
    f"Sisanya ({(talent_request['n_extracted']==0).sum():,}) tidak menyebut tools dari vocabulary yang dikenal -- kemungkinan soft-skill/istilah di luar 80 tools yang ada."
)


ts_with_tools_req = (
    tracking_student.merge(
        tracking_company[["id_tracking_company", "id_talent_req"]],
        on="id_tracking_company",
        how="left",
    )
    .merge(
        talent_request[["id_talent_req", "extracted_tools", "n_extracted"]],
        on="id_talent_req",
        how="left",
    )
    .merge(status_student[["NIM", "tools"]], on="NIM", how="left")
)

subset_reliable = ts_with_tools_req[ts_with_tools_req["n_extracted"] > 0].copy()


def cek_overlap(row):
    if pd.isna(row["tools"]):
        return False
    kandidat_tools = set(t.strip() for t in row["tools"].split(","))
    diminta_tools = set(row["extracted_tools"])
    return len(kandidat_tools & diminta_tools) > 0


subset_reliable["overlap"] = subset_reliable.apply(cek_overlap, axis=1)

pct_overlap = subset_reliable["overlap"].mean() * 100

print(
    f"Basis: {len(subset_reliable):,} baris tracking_student di mana request-nya punya tools terdeteksi ({len(subset_reliable)/len(ts_with_tools_req)*100:.1f}% dari total 41.600)\n"
)
print(
    f"% kandidat terkirim yang tools-nya OVERLAP dengan yang diminta: {pct_overlap:.1f}%"
)


np.random.seed(42)

actual_rate = subset_reliable["overlap"].mean() * 100

shuffled_tools = subset_reliable["tools"].sample(frac=1, random_state=42).values
subset_reliable["tools_shuffled"] = shuffled_tools


def cek_overlap_shuffled(row):
    if pd.isna(row["tools_shuffled"]):
        return False
    kandidat_tools = set(t.strip() for t in row["tools_shuffled"].split(","))
    diminta_tools = set(row["extracted_tools"])
    return len(kandidat_tools & diminta_tools) > 0


subset_reliable["overlap_random"] = subset_reliable.apply(cek_overlap_shuffled, axis=1)
random_rate = subset_reliable["overlap_random"].mean() * 100

print(f"Overlap rate AKTUAL       : {actual_rate:.1f}%")
print(f"Overlap rate BASELINE ACAK: {random_rate:.1f}%")
print(f"Selisih                   : +{actual_rate - random_rate:.1f} poin persentase\n")

print(
    f"""
KESIMPULAN 5.3b (dengan baseline):
Overlap tools AKTUAL: {actual_rate:.1f}% vs BASELINE ACAK: {random_rate:.1f}%
(selisih +{actual_rate - random_rate:.1f} poin persentase)

BERBEDA dari temuan lokasi (5.4) yang setara dengan acak, di sini ada
SINYAL NYATA bahwa tools dipertimbangkan dalam matching -- overlap jauh
di atas kebetulan. Namun overlap {actual_rate:.1f}% (bukan mendekati 100%)
menunjukkan ini BUKAN filter ketat/wajib, dan korelasi ini mungkin sebagian
merupakan efek TIDAK LANGSUNG dari matching prodi (5.1, 100% ditegakkan) --
karena tools cenderung berkorelasi dengan program studi. Cakupan analisis
