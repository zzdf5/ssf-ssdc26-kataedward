# -- PERBAIKAN: uji signifikansi sebelum menyimpulkan, jangan cuma bandingkan angka mentah --
overall_rate = resolved_df["final_outcome"].eq("Placement").mean()
print(
    f"\nUji signifikansi (Z-score) per kategori vs rata-rata keseluruhan ({overall_rate*100:.1f}%):"
)

signifikan_ditemukan = False
for jenis in jenis_rate.index:
    n = jenis_rate.loc[jenis, "total_resolved"]
    rate = jenis_rate.loc[jenis, "placement_rate"] / 100
    se = np.sqrt(overall_rate * (1 - overall_rate) / n)
    z = (rate - overall_rate) / se
    is_sig = abs(z) > 1.96
    if is_sig:
        signifikan_ditemukan = True
    print(
        f"   {jenis:12s}: n={n:6,d}  rate={rate*100:.2f}%  z={z:.2f}  {'SIGNIFIKAN' if is_sig else 'tidak signifikan'}"
    )

if signifikan_ditemukan:
    print(
        f"\n>>> Ada perbedaan yang SIGNIFIKAN secara statistik antar jenis penempatan."
    )
else:
    print(
        f"\n>>> TIDAK ADA perbedaan yang signifikan secara statistik antar jenis penempatan"
    )
    print(
        f"    (semua |Z| < 1.96). Selisih {jenis_rate['placement_rate'].max()-jenis_rate['placement_rate'].min():.2f} poin"
    )
    print(
        f"    persentase antar kategori adalah NOISE, bukan pola nyata -- jenis penempatan"
    )
    print(f"    TIDAK memengaruhi placement rate secara berarti.")


