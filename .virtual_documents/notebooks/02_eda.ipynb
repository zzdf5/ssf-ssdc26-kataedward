def rekap_durasi(df, kolom):
    hasil = (
        df.groupby(kolom)["hari_terlewat"]
        .agg(["size", "median", "mean"])
        .sort_values("median")
    )
    hasil.columns = ["n", "median_hari", "mean_hari"]
    return hasil


