def klasifikasi_formula(hari):
    if hari > 28:
        return "Ghosting"
    elif hari > 21:
        return "FU3"
    elif hari > 14:
        return "FU2"
    elif hari > 7:
        return "FU1"
    else:
        return "<=1 minggu"


