def rate_draft_per_grup(df, kolom):
    total = df.groupby(kolom).size()
    draft = df[df["is_draft"]].groupby(kolom).size()
    hasil = pd.DataFrame({"total": total, "draft": draft}).fillna(0)
    hasil["draft"] = hasil["draft"].astype(int)
    hasil["rate_draft"] = hasil["draft"] / hasil["total"] * 100
    return hasil.sort_values("rate_draft", ascending=False)


