        window_str = f"> {lo}"
    else:
        patuh = ((subset["hari_terlewat"] > lo) & (subset["hari_terlewat"] <= hi)).sum()
        window_str = f"({lo}, {hi}]"

    pct_patuh = patuh / n * 100
    hasil.append(
