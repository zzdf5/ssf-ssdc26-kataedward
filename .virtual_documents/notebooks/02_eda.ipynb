from scipy import stats

ilmu_hukum = bidang_exploded[bidang_exploded["bidang"] == "Ilmu Hukum"][
    "tidak_terpenuhi"
]
n_ih = len(ilmu_hukum)
rate_ih = ilmu_hukum.mean()
baseline_rate = closed_requests["tidak_terpenuhi"].mean()

se = np.sqrt(baseline_rate * (1 - baseline_rate) / n_ih)
z_score = (rate_ih - baseline_rate) / se

print(
    f"Ilmu Hukum: n={n_ih}, rate={rate_ih*100:.1f}%, baseline={baseline_rate*100:.1f}%"
)
print(
    f"Z-score: {z_score:.2f} ({'signifikan (>1.96)' if abs(z_score) > 1.96 else 'TIDAK signifikan secara statistik, n terlalu kecil'})"
)


def hitung_zscore(df, kolom_bidang, kolom_flag, baseline):
    hasil = []
    for bidang, grup in df.groupby(kolom_bidang):
        n = len(grup)
        if n < 20:
            continue
        rate = grup[kolom_flag].mean()
        se = np.sqrt(baseline * (1 - baseline) / n)
        z = (rate - baseline) / se
        hasil.append((bidang, n, rate * 100, z))
    return pd.DataFrame(
        hasil, columns=["bidang", "n", "rate_%", "z_score"]
    ).sort_values("z_score", ascending=False)


zscore_semua = hitung_zscore(
    bidang_exploded, "bidang", "tidak_terpenuhi", baseline_rate
)
zscore_semua["signifikan"] = zscore_semua["z_score"].abs() > 1.96

print("Semua bidang (min n=20) urut Z-score, tandai yang signifikan:")
print(zscore_semua.to_string(index=False))

n_signifikan = zscore_semua["signifikan"].sum()
print(
    f"\n>>> {n_signifikan} dari {len(zscore_semua)} bidang menunjukkan gap SIGNIFIKAN dari baseline"
)





